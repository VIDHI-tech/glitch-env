{
  "name": "glitch-student-environment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test test/*.test.js",
    "seed": "node scripts/manage.js seed",
    "admin": "node scripts/manage.js admin",
    "check": "node --check src/server.js && node --check src/platform.js && node --check public/app.js",
    "m1:typecheck": "pnpm -r --filter \"@glitch/*\" typecheck",
    "m1:build": "pnpm --filter @glitch/api build && pnpm --filter @glitch/web build",
    "test:e2e": "playwright test",
    "test:m1:integration": "pnpm --filter @glitch/api test:integration",
    "test:m2:integration": "pnpm --filter @glitch/api test:m2:integration",
    "test:m3:integration": "pnpm --filter @glitch/api test:m3:integration",
    "test:m4:integration": "pnpm --filter @glitch/api test:m4:integration",
    "test:m5:integration": "pnpm --filter @glitch/api test:m5:integration",
    "test:m4:e2e": "playwright test -c playwright.m4.config.ts",
    "test:m5:e2e": "playwright test -c playwright.m5.config.ts"
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
