{
  "name": "glitch-student-environment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test test/*.test.js",
    "seed": "node scripts/manage.js seed",
    "admin": "node scripts/manage.js admin",
    "check": "node --check src/server.js && node --check src/platform.js && node --check public/app.js"
  }
}
